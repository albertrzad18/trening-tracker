<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikona: wykres kołowy z trzech wycinków w kolorach dyscyplin (basen 45%, rower 35%, trenażer 20%).
  Kąty liczone od góry zgodnie z ruchem wskazówek: 0°, 162°, 288°. Koło r=27 wokół środka 54,54;
  wycinek trenażera jest wysunięty o 3 na zewnątrz, więc całość mieści się w bezpiecznej strefie (r=33).
  Szczeliny między wycinkami to obrys w kolorze tła.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Basen -->
    <path
        android:fillColor="#6E9BFF"
        android:pathData="M54,54 L54,27 A27,27 0 0,1 62.34,79.68 Z"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />
    <!-- Rower -->
    <path
        android:fillColor="#4CC985"
        android:pathData="M54,54 L62.34,79.68 A27,27 0 0,1 28.32,45.66 Z"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round" />
    <!-- Trenażer, wysunięty wzdłuż środka wycinka (324°) -->
    <group
        android:translateX="-1.76"
        android:translateY="-2.43">
        <path
            android:fillColor="#FF9E4A"
            android:pathData="M54,54 L28.32,45.66 A27,27 0 0,1 54,27 Z"
            android:strokeColor="@color/ic_launcher_background"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round" />
    </group>
</vector>
