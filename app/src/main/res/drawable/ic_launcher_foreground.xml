<?xml version="1.0" encoding="utf-8"?>
<!--
  Ikona: płonący skręt ułożony ukośnie, z żarem i płomieniem na końcu.
  Skręt rysujemy poziomo i obracamy grupą o -40° wokół (52,62); płomień jest poza grupą,
  żeby zawsze strzelał pionowo w górę. Wszystko mieści się w bezpiecznej strefie ikony (koło r=33 wokół środka).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="52"
        android:pivotY="62"
        android:rotation="-40">
        <!-- Ustnik z tektury -->
        <path
            android:fillColor="#C8A27A"
            android:pathData="M28,58.5 L34,58.2 L34,65.8 L28,65.5 Z" />
        <path
            android:pathData="M30.5,58.4 L30.5,65.6 M32.5,58.3 L32.5,65.7"
            android:strokeColor="#A07D58"
            android:strokeWidth="0.8" />
        <!-- Bibułka, lekko rozszerzająca się ku końcowi -->
        <path
            android:fillColor="#F5EEDF"
            android:pathData="M34,58.2 L72,57 Q74.5,62 72,67 L34,65.8 Z" />
        <!-- Popiół -->
        <path
            android:fillColor="#8A8A8A"
            android:pathData="M72,57 Q74.5,62 72,67 L74,66.5 Q76.5,62 74,57.5 Z" />
        <!-- Żar -->
        <path
            android:fillColor="#FF5722"
            android:pathData="M74,57.5 Q76.5,62 74,66.5 Q77.5,64 77.5,62 Q77.5,60 74,57.5 Z" />
    </group>

    <!-- Płomień: zewnętrzny pomarańczowy i wewnętrzny żółty -->
    <path
        android:fillColor="#FF9800"
        android:pathData="M71,47 C62,44 62,35 68,28 C68,34 73,35 72,29 C80,35 80,44 71,47 Z" />
    <path
        android:fillColor="#FFD54F"
        android:pathData="M71,45 C67,43 67,38 70,34 C70.5,37 73,38 73,35 C76,39 75,43 71,45 Z" />
</vector>
